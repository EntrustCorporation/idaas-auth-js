{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "configMigration": true,
  "extends": ["config:best-practices", "security:minimumReleaseAgeNpm", ":automergeAll"],
  "lockFileMaintenance": {
    "enabled": true,
    "automerge": true
  },
  "postUpgradeTasks": {
    "commands": ["bun run docs:generate"],
    "fileFilters": ["docs/**"],
    "executionMode": "branch",
    "installTools": {}
  },
  "osvVulnerabilityAlerts": true
}
